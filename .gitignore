# Installed packages and per-machine runtime data must not enter source control.
node_modules/
data/
*.db
*.sqlite
*.sqlite3
*.pem
# Public half only, and it must ship with the manifest.sig it verifies: every firmware repackage
# signs with a fresh key, so leaving this out made a clean checkout fail its own package check.
!resources/firmware/internal-test/internal-test-public.pem
*.key
.phase51-build-tools/
.phase51-downloads/
.phase51-pyinstaller-work/
.phase51-pyinstaller-spec/
runtime/firmware-packages/
runtime/electron-test-user-data/
tools/phase5_1/dist/
tools/phase5_1/test-keys/
*.nvs.csv
*.nvs.bin
.env
.env.*

# Build/packaging output (large binaries, not source)
output/
tmp/
.pio/
dist_installer/
